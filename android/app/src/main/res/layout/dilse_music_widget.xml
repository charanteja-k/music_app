<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dilse_widget_background">

    <!-- Dynamic Glassmorphic Dominant-Color Background Canvas -->
    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Widget Background" />

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Playback Deck: Album Artwork (Left) + Metadata & Responsive Controls (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Rounded Squircle Album Artwork -->
            <ImageView
                android:id="@+id/widget_album_art"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:scaleType="centerCrop"
                android:contentDescription="Album Art"
                android:src="@drawable/ic_stat_music" />

            <!-- Track Metadata, Controls & Interactive Scrubber -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:gravity="center_vertical">

                <!-- Song Title -->
                <TextView
                    android:id="@+id/widget_song_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DilSe Music"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="marquee" />

                <!-- Artist Name -->
                <TextView
                    android:id="@+id/widget_song_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tap to play"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="1.5dp" />

                <!-- Responsive Fluid Playcontrols Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="5dp">

                    <!-- Shuffle Toggle -->
                    <ImageView
                        android:id="@+id/widget_btn_shuffle"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:padding="8dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_widget_shuffle"
                        android:contentDescription="Shuffle" />

                    <!-- Previous Track -->
                    <ImageView
                        android:id="@+id/widget_btn_prev"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:padding="6dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/audio_service_skip_previous"
                        android:contentDescription="Previous" />

                    <!-- Glowing Circular Play / Pause Deck -->
                    <ImageView
                        android:id="@+id/widget_btn_play_pause"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1.3"
                        android:padding="2dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/audio_service_play_arrow"
                        android:contentDescription="Play/Pause" />

                    <!-- Next Track -->
                    <ImageView
                        android:id="@+id/widget_btn_next"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:padding="6dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/audio_service_skip_next"
                        android:contentDescription="Next" />

                    <!-- Repeat Toggle -->
                    <ImageView
                        android:id="@+id/widget_btn_repeat"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:padding="8dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_widget_repeat"
                        android:contentDescription="Repeat" />

                </LinearLayout>

                <!-- Interactive Scrubber: Visual ProgressBar + 10 Clickable Touch-Seek Zones -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="3dp">

                    <!-- Visual Progress Bar -->
                    <ProgressBar
                        android:id="@+id/widget_progress_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4.5dp"
                        android:layout_gravity="center_vertical"
                        android:max="1000"
                        android:progress="0"
                        android:progressDrawable="@drawable/dilse_widget_progress" />

                    <!-- 10 Responsive Tap-To-Seek Segments Overlay -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/widget_seek_zone_0"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />

                        <View
                            android:id="@+id/widget_seek_zone_1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />

                        <View
                            android:id="@+id/widget_seek_zone_2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />

                        <View
                            android:id="@+id/widget_seek_zone_3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />

                        <View
                            android:id="@+id/widget_seek_zone_4"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />

                        <View
                            android:id="@+id/widget_seek_zone_5"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />

                        <View
                            android:id="@+id/widget_seek_zone_6"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />

                        <View
                            android:id="@+id/widget_seek_zone_7"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />

                        <View
                            android:id="@+id/widget_seek_zone_8"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />

                        <View
                            android:id="@+id/widget_seek_zone_9"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?android:attr/selectableItemBackgroundBorderless" />

                    </LinearLayout>

                </FrameLayout>

                <!-- Monospace Timestamps with Quick Tap-Seek Targets -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="1dp">

                    <TextView
                        android:id="@+id/widget_time_current"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0:00"
                        android:textColor="#99FFFFFF"
                        android:textSize="9.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="?android:attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/widget_time_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="#99FFFFFF"
                        android:textSize="9.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="?android:attr/selectableItemBackgroundBorderless" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Bottom Shelf: 5 Prominent Top Playlists / Quick-Launch Badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <!-- Playlist 0 -->
            <LinearLayout
                android:id="@+id/widget_playlist_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="2dp"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/widget_playlist_art_0"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Playlist 1" />

                <TextView
                    android:id="@+id/widget_playlist_title_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Daily Mix"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Playlist 1 -->
            <LinearLayout
                android:id="@+id/widget_playlist_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="2dp"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/widget_playlist_art_1"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Playlist 2" />

                <TextView
                    android:id="@+id/widget_playlist_title_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Favorites"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Playlist 2 -->
            <LinearLayout
                android:id="@+id/widget_playlist_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="2dp"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/widget_playlist_art_2"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Playlist 3" />

                <TextView
                    android:id="@+id/widget_playlist_title_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Most Played"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Playlist 3 -->
            <LinearLayout
                android:id="@+id/widget_playlist_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="2dp"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/widget_playlist_art_3"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Playlist 4" />

                <TextView
                    android:id="@+id/widget_playlist_title_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="History Replay"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Playlist 4 -->
            <LinearLayout
                android:id="@+id/widget_playlist_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="2dp"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/widget_playlist_art_4"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Playlist 5" />

                <TextView
                    android:id="@+id/widget_playlist_title_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Chill Vibes"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
